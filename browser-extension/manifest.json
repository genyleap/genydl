{
  "manifest_version": 3,
  "name": "GenyDL – Download with GenyDL",
  "description": "Hand off supported browser downloads to the GenyDL desktop application.",
  "version": "1.3.3",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GenyDL download integration",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "64": "icon64.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@genyleap.com",
      "data_collection_permissions": {
        "required": [
          "websiteActivity"
        ]
      },
      "strict_min_version": "142.0"
    }
  }
}
