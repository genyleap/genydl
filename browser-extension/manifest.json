{
  "manifest_version": 3,
  "name": "Download with GenyDL",
  "description": "Hand off supported browser downloads to the GenyDL desktop application.",
  "version": "1.1.1",
  "icons": {"128": "icon128.png"},
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "GenyDL download integration"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "download-links@genydl.genyleap.com"
    }
  }
}
