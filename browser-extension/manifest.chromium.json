{
  "manifest_version": 3,
  "name": "Download with GenyDL",
  "description": "User-controlled downloads with the GenyDL desktop application.",
  "version": "1.3.0",
  "icons": {"128": "icon128.png"},
  "permissions": [
    "nativeMessaging", "storage", "contextMenus"
  ],
  "optional_permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "GenyDL download integration"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
