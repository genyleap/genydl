{
  "manifest_version": 3,
  "name": "GenyDL – Download with GenyDL",
  "description": "User-controlled downloads with the GenyDL desktop application.",
  "version": "1.3.3",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GenyDL download integration",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "64": "icon64.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "short_name": "GenyDL Opera"
}
